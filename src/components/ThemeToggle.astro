---
// Light/dark mode toggle. Compact icon pill in the header; a wider labelled
// pill (`labelled`) under a post's title, with the mode name inside.
interface Props {
  labelled?: boolean;
}
const { labelled = false } = Astro.props;
---

<button class:list={['theme-toggle', { 'theme-toggle--labelled': labelled }]} type="button" aria-label="Toggle dark mode">
  <svg class="icon-sun" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
    <circle cx="12" cy="12" r="4.2"></circle>
    <path d="M12 2.5v2.4M12 19.1v2.4M4.2 4.2l1.7 1.7M18.1 18.1l1.7 1.7M2.5 12h2.4M19.1 12h2.4M4.2 19.8l1.7-1.7M18.1 5.9l1.7-1.7"></path>
  </svg>
  <svg class="icon-moon" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a6.8 6.8 0 0 0 10.5 10.5z"></path>
  </svg>
  {labelled && <span class="btn-text btn-text--light">Light mode</span>}
  {labelled && <span class="btn-text btn-text--dark">Dark mode</span>}
</button>

<script>
  // One delegated handler for every theme toggle on the page. State lives on
  // <html> as data-theme (applied before first paint by BaseLayout from
  // localStorage); the CSS reacts to that attribute.
  const root = document.documentElement;
  const darkMq = window.matchMedia('(prefers-color-scheme: dark)');
  const isDark = () => (root.getAttribute('data-theme') ?? (darkMq.matches ? 'dark' : 'light')) === 'dark';

  const setTheme = (next: 'light' | 'dark') => {
    root.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
    window.dispatchEvent(new Event('themechange'));
  };

  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('.theme-toggle')) return;
    setTheme(isDark() ? 'light' : 'dark');
  });
</script>
